# Application Environment Variables Template
# Copy to .env.local for local development. Never commit sensitive values.

NODE_ENV=development
PORT=3000

# Database Configuration (Placeholder)
DATABASE_URL="postgresql://user:password@localhost:5432/app_dev?schema=public"

# Authentication Secrets (Placeholder)
AUTH_SECRET="your-development-secret-must-be-at-least-32-chars"
NEXTAUTH_URL="http://localhost:3000"
